<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>FolderScope</RootNamespace>
    <AssemblyName>FolderScope</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The manifest declares PerMonitorV2 as well. The WinForms SDK flags that pair; both are intentional. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Version>1.2.2</Version>
    <FileVersion>1.2.2.0</FileVersion>
    <InformationalVersion>1.2.2</InformationalVersion>
    <Company>FolderScope</Company>
    <Product>FolderScope</Product>
    <Description>See which folders are using disk space.</Description>
    <Copyright>Copyright © 2026</Copyright>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FolderScope.Core\FolderScope.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="FolderScope.app.ico" />
  </ItemGroup>

</Project>
